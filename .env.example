BOT_TOKEN=123456789:YOUR_TELEGRAM_BOT_TOKEN
ADMIN_IDS=111111111,222222222
DB_PATH=./data/feedback.db
LOG_LEVEL=info
# Max characters in a single feedback submission
FEEDBACK_MAX_LEN=2000
# Minimum seconds between two submissions from the same user (0 disables)
RATE_LIMIT_SECONDS=20
# How long "/feedback" waits for the next message, in seconds
PENDING_TTL_SECONDS=300
# Feedback items shown per /inbox page
INBOX_PAGE_SIZE=10

# --- WhatsApp (Baileys) ---
# Set to 0 to run as a feedback bot only
WA_ENABLED=1
# Where the paired session is stored. Never commit this.
WA_AUTH_DIR=./data/wa-auth
# Applied to local numbers typed without a country code, e.g. 233 for Ghana
WA_DEFAULT_COUNTRY=
# Minimum gap between outgoing messages, in milliseconds
WA_SEND_MIN_INTERVAL_MS=1500
# Hard cap on outgoing messages per rolling hour
WA_SEND_HOURLY_CAP=30
# Groups listed by /groups
WA_GROUP_LIST_LIMIT=20
# How many recent inbound media messages are kept so they can be saved from Telegram
WA_INBOX_LIMIT=40
