BOT_TOKEN=123456789:YOUR_TELEGRAM_BOT_TOKEN
ADMIN_IDS=111111111,222222222
DB_PATH=./data/feedback.db
LOG_LEVEL=info
# Max characters in a single feedback submission
FEEDBACK_MAX_LEN=2000
# Minimum seconds between two submissions from the same user (0 disables)
RATE_LIMIT_SECONDS=20
# How long "/feedback" waits for the next message, in seconds
PENDING_TTL_SECONDS=300
# Feedback items shown per /inbox page
INBOX_PAGE_SIZE=10
